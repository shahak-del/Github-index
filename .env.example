# === REQUIRED: fill these values locally. NEVER send this file in chat. ===
DROPBOX_ACCESS_TOKEN=
QDRANT_URL=
QDRANT_API_KEY=

# === Index settings ===
QDRANT_COLLECTION=dropbox_knowledge
SOURCE_NAME=dropbox

# Embeddings: multilingual, suitable for Hebrew + English.
# provider: "local" (sentence-transformers, no API key needed) or "openai"/"cohere" (needs EMBEDDING_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Optional provider credential, only if the selected embedding provider requires it.
EMBEDDING_API_KEY=
